{
  "name": "@qwenpaw/plugin-sdk",
  "version": "1.1.0",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./globals": {
      "types": "./globals.d.ts",
      "default": "./globals.js"
    }
  },
  "files": [
    "*.js",
    "*.d.ts",
    "README.md",
    "check.mjs"
  ],
  "peerDependencies": {
    "@types/react": ">=18 <20",
    "typescript": ">=5.8 <6"
  },
  "license": "Apache-2.0",
  "bin": {
    "qwenpaw-sdk-check": "./check.mjs"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
